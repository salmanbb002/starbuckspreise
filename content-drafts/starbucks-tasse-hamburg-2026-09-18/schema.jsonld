      "@type": "FAQPage",
      "@id": "https://starbuckspreise.com/blog/starbucks-tasse-hamburg/#faq",
      "mainEntity": [
        { "@type": "Question", "name": "Gibt es die Starbucks Tasse Hamburg noch aktuell in den Filialen?", "acceptedAnswer": { "@type": "Answer", "text": "Nein, für 2026 ließ sich keine bestätigte aktuelle Been-There-Ausgabe für Hamburg finden. Verfügbar ist nur die 2016er You-Are-Here-Tasse über Fachhändler und Zweitmarkt." } },
        { "@type": "Question", "name": "Was kostet die Starbucks Tasse Hamburg neu?", "acceptedAnswer": { "@type": "Answer", "text": "Der Fachhändler thecoffeemugshop.de verkauft sie für 29,99 Euro (reduziert von 32,99 Euro), der Schweizer Anbieter queenshop.ch für 35,00 Franken." } },
        { "@type": "Question", "name": "Welches Motiv zeigt die Starbucks Tasse Hamburg?", "acceptedAnswer": { "@type": "Answer", "text": "Vorne das Hamburger Rathaus, hinten die HafenCity-Skyline, beides in dunkelblauer Farbgebung mit weißen Konturen." } },
        { "@type": "Question", "name": "Wie viel ml fasst die Starbucks Tasse Hamburg?", "acceptedAnswer": { "@type": "Answer", "text": "Laut thecoffeemugshop.de und starbucks-mugs.com 414 ml (14 fl oz); ein Schweizer Händler nennt abweichend 16 fl oz." } },
        { "@type": "Question", "name": "Wo kann ich die Starbucks Tasse Hamburg gebraucht kaufen?", "acceptedAnswer": { "@type": "Answer", "text": "Auf eBay.de und Kleinanzeigen.de erscheinen laufend Angebote privater Verkäufer, mit Preisen zwischen etwa 15 und über 90 US-Dollar je nach Zustand." } },
        { "@type": "Question", "name": "Ist die Hamburg-Tasse auch in anderen Städten erhältlich?", "acceptedAnswer": { "@type": "Answer", "text": "Nein, Städtetassen gelten grundsätzlich nur für die jeweilige Stadt-Filiale; da Hamburg aber ohnehin keine laufende Filialausgabe hat, betrifft das nur theoretisch." } },
        { "@type": "Question", "name": "Woran erkenne ich eine echte statt einer gefälschten Hamburg-Tasse?", "acceptedAnswer": { "@type": "Answer", "text": "Achten Sie auf einen scharfen Bodenstempel mit Copyright- und Füllmengenangabe, einen originalen SKU-Aufkleber und eine symmetrische, saubere Motivprägung." } },
        { "@type": "Question", "name": "Ist die Starbucks Tasse Hamburg spülmaschinen- und mikrowellengeeignet?", "acceptedAnswer": { "@type": "Answer", "text": "Ja, laut Händlerangaben ist die Standard-Keramikausgabe spülmaschinenfest und mikrowellengeeignet." } },
        { "@type": "Question", "name": "Wann wurde die Starbucks Tasse Hamburg zum ersten Mal veröffentlicht?", "acceptedAnswer": { "@type": "Answer", "text": "Im Juni 2016, als Teil der damals neuen You-Are-Here-Serie, die 2018 von der Been-There-Serie abgelöst wurde." } },
        { "@type": "Question", "name": "Gibt es die Hamburg-Tasse auch als kleinere Version oder Tumbler?", "acceptedAnswer": { "@type": "Answer", "text": "Kollektionsverzeichnisse führen neben der Standardtasse auch eine Demi-Set- und eine Tumbler-Variante für Hamburg auf; Detailangaben zu Preis und Verfügbarkeit ließen sich dafür nicht bestätigen." } }
