    {
      "@type": "FAQPage",
      "@id": "https://starbuckspreise.com/blog/starbucks-gebaeck#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Was kostet eine Zimtschnecke bei Starbucks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die klassische Zimtschnecke kostet 3,80 €. Die gefüllten Sorten wie die Apple Crumble Cinnamon Roll oder die Carrot Cake Zimtschnecke kosten 4,20 bis 4,40 €. Drei Zimtschnecken im Bundle kosten 11,40 €."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viele Kalorien hat ein Starbucks Muffin?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein Starbucks Muffin hat 408 bis 473 kcal. Der Blaubeer Muffin hat 435 kcal, der Chocolate Cheesecake Muffin 439 kcal und der Matcha Cherry Blob Muffin 473 kcal."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viele Kalorien hat der Starbucks Carrot Cake?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein Stück Carrot Cake hat 817 kcal bei 181 g Gewicht. Das sind 58 g Zucker und 8,5 g Eiweiß. Er ist damit das kalorienreichste Gebäck bei Starbucks."
          }
        },
        {
          "@type": "Question",
          "name": "Ist das Starbucks Gebäck frisch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Einige Produkte stehen mit dem Zusatz „Ofenfrisch“ auf der Karte: Mini Pastel de Nata, Signature Cones, Croissant und Pain au Chocolat. Sie werden in der Filiale gebacken. Kuchen, Muffins und Cookies tragen diesen Hinweis nicht."
          }
        },
        {
          "@type": "Question",
          "name": "Kann ich Starbucks Kuchen bestellen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. Viele Filialen sind über Lieferdienste bestellbar, in Freiburg zum Beispiel mit Bundles wie „Kuchenträume“ (sechs Kuchen für 22,70 €). Im Sortiment stehen Kuchenstücke, keine ganzen Torten."
          }
        },
        {
          "@type": "Question",
          "name": "Ist der Starbucks Brownie glutenfrei?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In der Allergenliste von Starbucks ist beim Chocolate Brownie kein glutenhaltiges Getreide markiert. Starbucks schließt Kreuzkontamination aber nicht aus. Für Menschen mit Zöliakie ist er deshalb nicht sicher."
          }
        },
        {
          "@type": "Question",
          "name": "Was ist ein Cake Pop?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein Cake Pop ist eine Kugel aus Kuchen am Stiel, überzogen mit einer Glasur. Bei Starbucks kostet er 2,80 € und hat je nach Sorte 101 bis 168 kcal. Die Sorten wechseln mit der Saison."
          }
        },
        {
          "@type": "Question",
          "name": "Welcher Starbucks Kuchen ist am beliebtesten?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Starbucks veröffentlicht keine Verkaufszahlen. Zu den Klassikern, die sowohl im Winter 2025 als auch im Herbst 2026 auf der Karte stehen, gehören Carrot Cake, New York Cheesecake, Chocolate Lover Cake, Zitronen- und Marmorkuchen."
          }
        },
        {
          "@type": "Question",
          "name": "Gibt es Gebäck in der Starbucks App?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. In Filialen mit Mobile Order & Pay kannst du Gebäck in der Starbucks App vorbestellen. Für jeden Euro bekommst du 3 Sterne, auch beim Kauf von Gebäck."
          }
        },
        {
          "@type": "Question",
          "name": "Welches Gebäck gibt es nur im Herbst?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Im Herbst 2026 sind das Pumpkin Spice Loaf Cake, Pecan Maple Cake, Crunchy Pecan Maple Bar, Apple Crumble Cinnamon Roll und der Pumpkin Spice Cake Pop. Dazu kommen zu Halloween der Mystery Black Cat Swirl und der Mystery Black Cat Cake Pop. Alle anderen Preise stehen in unserer Starbucks Preisliste."
          }
        }
      ]
    },
