      "@type": "FAQPage",
      "@id": "https://starbuckspreise.com/blog/starbucks-flat-white/#faq",
      "mainEntity": [
        {"@type": "Question", "name": "Was ist ein Flat White bei Starbucks?", "acceptedAnswer": {"@type": "Answer", "text": "Ein Espresso-Getränk aus einem doppelten Espresso und gedämpfter Milch mit dünner Mikroschaum-Schicht – weniger Milch als ein Latte."}},
        {"@type": "Question", "name": "Was kostet ein Starbucks Flat White in Deutschland?", "acceptedAnswer": {"@type": "Answer", "text": "Laut Drittquelle 4,71 €. Eine offizielle Starbucks-Preisliste existiert nicht."}},
        {"@type": "Question", "name": "Wie viele Kalorien hat ein Starbucks Flat White?", "acceptedAnswer": {"@type": "Answer", "text": "Mit Vollmilch (Short) rund 76 kcal, mit Hafermilch rund 70 kcal."}},
        {"@type": "Question", "name": "Worin unterscheidet sich der Flat White vom Latte?", "acceptedAnswer": {"@type": "Answer", "text": "Er enthält weniger Milch und eine dünnere Schaumschicht, dadurch schmeckt er espressobetonter."}},
        {"@type": "Question", "name": "Worin unterscheidet sich der Flat White vom Cappuccino?", "acceptedAnswer": {"@type": "Answer", "text": "Ihm fehlt die dicke, luftige Schaumhaube des Cappuccinos – die Milch bleibt cremig statt aufgeschäumt."}},
        {"@type": "Question", "name": "Kommt der Flat White aus Australien oder Neuseeland?", "acceptedAnswer": {"@type": "Answer", "text": "Umstritten: Beide Länder beanspruchen die Erfindung; ein Kaffeehistoriker verortet den Ursprung sogar im England der 1950er-Jahre."}},
        {"@type": "Question", "name": "Seit wann gibt es den Flat White bei Starbucks?", "acceptedAnswer": {"@type": "Answer", "text": "In den US-Filialen seit dem 6. Januar 2015, danach international eingeführt."}},
        {"@type": "Question", "name": "Gibt es den Flat White auch als Iced-Variante?", "acceptedAnswer": {"@type": "Answer", "text": "Ja, Starbucks führt den Flat White sowohl heiß als auch als Iced Flat White."}},
        {"@type": "Question", "name": "Was ist die Starbucks Flat White Eiskaffee-Dose?", "acceptedAnswer": {"@type": "Answer", "text": "Eine 220-ml-Dose für den Supermarkt, ca. 2,29 € bei Rewe, Nutri-Score B, 66 kcal pro 100 ml."}},
        {"@type": "Question", "name": "Wer produziert die Starbucks-Eiskaffee-Dosen in Deutschland?", "acceptedAnswer": {"@type": "Answer", "text": "Arla Foods, eine dänische Molkereigenossenschaft mit 21-jähriger EMEA-Lizenz, produziert in Esbjerg."}},
        {"@type": "Question", "name": "Kann man den Flat White mit pflanzlicher Milch bestellen?", "acceptedAnswer": {"@type": "Answer", "text": "Ja, etwa mit Hafermilch – das senkt den Kaloriengehalt leicht gegenüber Vollmilch."}},
        {"@type": "Question", "name": "Warum taucht der Flat White nicht auf jeder Starbucks-Preisliste auf?", "acceptedAnswer": {"@type": "Answer", "text": "Weil manche Drittanbieter-Preislisten ihn schlicht auslassen – ein Vergleich mehrerer Quellen lohnt sich."}}
      ]
    }
