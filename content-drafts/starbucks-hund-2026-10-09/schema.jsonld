    {
      "@type": "HowTo",
      "@id": "https://starbuckspreise.com/blog/starbucks-hund/#howto",
      "name": "Wie fragst du bei Starbucks nach einem Puppuccino?",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "text": "Frag zuerst, ob dein Hund mit hinein darf, oder lass ihn bei einer zweiten Person draußen."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "text": "Bestell selbst etwas. Der Becher ist eine Gefälligkeit und kein eigenes Produkt."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "text": "Bitte um einen kleinen Becher mit etwas Schlagsahne für deinen Hund."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "text": "Akzeptiere ein Nein. Die Filiale muss den Wunsch nicht erfüllen."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "text": "Gib die Sahne vor der Tür und nicht an der Theke."
        }
      ]
    }
  ]
