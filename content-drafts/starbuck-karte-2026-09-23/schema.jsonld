      {"@type": "SoftwareApplication", "name": "Starbucks® Deutschland", "operatingSystem": "iOS, Android", "applicationCategory": "LifestyleApplication", "sameAs": "https://apps.apple.com/de/app/starbucks-deutschland/id948562829"}
