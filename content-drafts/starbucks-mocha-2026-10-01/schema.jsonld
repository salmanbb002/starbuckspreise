    {
      "@type": "HowTo",
      "name": "Mocha-Sauce selber machen",
      "supply": [
        {
          "@type": "HowToSupply",
          "name": "120 ml Wasser"
        },
        {
          "@type": "HowToSupply",
          "name": "100 g Zucker"
        },
        {
          "@type": "HowToSupply",
          "name": "30 g ungesüßtes Kakaopulver"
        },
        {
          "@type": "HowToSupply",
          "name": "1 Prise Salz"
        },
        {
          "@type": "HowToSupply",
          "name": "1/2 TL Vanilleextrakt"
        }
      ],
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "text": "Wasser, Zucker, Kakaopulver und Salz in einen kleinen Topf geben."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "text": "Bei mittlerer Hitze unter Rühren aufkochen, bis sich der Zucker gelöst hat."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "text": "Zwei Minuten leicht köcheln lassen, dann vom Herd nehmen."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "text": "Vanilleextrakt einrühren und abkühlen lassen."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "text": "In ein Schraubglas füllen und im Kühlschrank aufbewahren."
        }
      ]
    }
  ]
