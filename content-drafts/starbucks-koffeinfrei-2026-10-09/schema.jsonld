    {
      "@type": "FAQPage",
      "@id": "https://starbuckspreise.com/blog/starbucks-koffeinfrei#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Hat Starbucks entkoffeinierten Kaffee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, Starbucks Deutschland bietet Decaf an. In der Bestellkarte lässt sich bei 25 von 31 geprüften Kaffeegetränken die Bohne Decaf wählen. Dazu gehören Caffè Latte, Cappuccino, Caffè Americano und Caramel Macchiato."
          }
        },
        {
          "@type": "Question",
          "name": "Ist Decaf bei Starbucks komplett koffeinfrei?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein, Decaf enthält einen kleinen Rest Koffein. Ein Shot Decaf Espresso hat 1,8 mg, ein normaler Shot 44,5 mg. Die Kaffeeverordnung erlaubt bei entkoffeiniertem Röstkaffee bis zu 0,1 Prozent Koffein in der Trockenmasse."
          }
        },
        {
          "@type": "Question",
          "name": "Kostet Decaf bei Starbucks einen Aufpreis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die Bestellkarte zeigt für Decaf keinen Aufpreis. Die Bohne steht dort wie Signature Espresso und Blonde ohne Preisangabe. Verbindlich ist der Betrag an der Kasse deiner Filiale."
          }
        },
        {
          "@type": "Question",
          "name": "Was bedeutet Decaf?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Decaf ist die Kurzform des englischen Wortes decaffeinated und heißt entkoffeiniert. Starbucks nutzt das Wort in der Bestellkarte als Namen der Bohne. An der Theke kannst du genauso „entkoffeiniert“ sagen."
          }
        },
        {
          "@type": "Question",
          "name": "Gibt es bei Starbucks koffeinfreien Filterkaffee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein, der Filterkaffee hat in der Bestellkarte keine Bohnenauswahl. Er wird mit Pike Place Roast gebrüht und hat im Grande 254,6 mg Koffein. Die Alternative ist ein Decaf Caffè Americano mit 5,4 mg."
          }
        },
        {
          "@type": "Question",
          "name": "Gibt es Cold Brew ohne Koffein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein, Cold Brew gibt es bei Starbucks Deutschland nicht entkoffeiniert. Ein Grande hat 255,8 mg Koffein. Als kalte Alternative eignet sich ein Decaf Iced Caffè Americano mit 5,4 mg."
          }
        },
        {
          "@type": "Question",
          "name": "Welcher Starbucks Tee hat kein Koffein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mint Blend und Hibiscus sind koffeinfrei. Beide sind Kräutermischungen ohne Teeblätter und kosten in Freiburg 3,90 €. English Breakfast hat dagegen 102 mg Koffein im Grande."
          }
        },
        {
          "@type": "Question",
          "name": "Hat die heiße Schokolade bei Starbucks Koffein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, eine Classic Hot Chocolate Grande hat laut Nährwertliste 26,1 mg Koffein. Es stammt aus dem Kakao. Die Bestellkarte zeigt 0,0 mg an, das passt nicht zur Nährwertliste."
          }
        },
        {
          "@type": "Question",
          "name": "Ist Starbucks Refresha koffeinfrei?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein, aber der Wert ist niedrig. Die deutsche Nährwertliste nennt 4,9 mg für einen Strawberry Acai oder Mango Dragonfruit Refresha im Grande. Im Venti sind es 6,2 mg."
          }
        },
        {
          "@type": "Question",
          "name": "Welcher Frappuccino ist koffeinfrei?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Vanilla Cream, Caramel Cream, Strawberries and Cream, Cookies and Cream und Pumpkin Spice Cream haben 0 mg Koffein. Chocolate Cream hat im Grande 10,3 mg, Matcha Cream 74,3 mg. Die Frappuccinos mit Kaffee gibt es als Decaf."
          }
        },
        {
          "@type": "Question",
          "name": "Kann ich Chai Latte oder Matcha Latte koffeinfrei bestellen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein, bei beiden kommt das Koffein aus dem Tee und lässt sich nicht abwählen. Ein Chai Tea Latte Grande hat 52,4 mg, ein Matcha Green Tea Latte Grande 83,0 mg. Die Bestellkarte bietet bei beiden keine Bohnenauswahl."
          }
        },
        {
          "@type": "Question",
          "name": "Gibt es Starbucks Decaf als Nespresso-Kapseln?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, Starbucks at Home führt den Blonde Espresso Roast Decaf by Nespresso mit 10 Kapseln pro Packung. Er hat die Intensität 6 und besteht aus 100 Prozent Arabica. Im Café gibt es zusätzlich die Bohne Decaf Espresso Roast."
          }
        }
      ]
    },
