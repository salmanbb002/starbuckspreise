    {
      "@type": "HowTo",
      "@id": "https://starbuckspreise.com/blog/starbucks-koffeinfrei/#howto",
      "name": "Wie bestellst du koffeinfrei bei Starbucks?",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "text": "Wähle ein Getränk mit Espresso, zum Beispiel Caffè Latte, Cappuccino oder Caffè Americano."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "text": "Lege die Größe fest: Tall, Grande oder Venti. Größere Becher enthalten meist mehr Shots."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "text": "Tippe bei der Bohnenauswahl auf Decaf. Voreingestellt ist Signature Espresso."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "text": "Passe Milch und Sirup an. Beides ändert am Koffein nichts."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "text": "Sag an der Theke „Decaf“ oder „entkoffeiniert“ zusammen mit dem Getränk."
        }
      ]
    }
  ]
