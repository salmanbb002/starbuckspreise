      "mainEntity": [
        {"@type": "Question", "name": "Wo genau ist der Starbucks in Heilbronn?", "acceptedAnswer": {"@type": "Answer", "text": "An der Kilianstraße 6, 74072 Heilbronn, in der Innenstadt."}},
        {"@type": "Question", "name": "Welche Öffnungszeiten hat Starbucks in Heilbronn?", "acceptedAnswer": {"@type": "Answer", "text": "Montag bis Freitag 08:30–21:00 Uhr, Samstag 08:30–21:30 Uhr, Sonntag 08:30–20:30 Uhr, laut dem offiziellen Store Locator zum Recherchestand."}},
        {"@type": "Question", "name": "Hat Starbucks in Heilbronn auch sonntags geöffnet?", "acceptedAnswer": {"@type": "Answer", "text": "Ja, sonntags von 08:30 bis 20:30 Uhr."}},
        {"@type": "Question", "name": "Gibt es in der Nähe der Kilianstraße Parkplätze?", "acceptedAnswer": {"@type": "Answer", "text": "Ja, der Shop- und Gastrofinder der Stadt Heilbronn verzeichnet für diese Adresse Parkplätze in der Nähe."}},
        {"@type": "Question", "name": "Gibt es mehr als eine Starbucks-Filiale in Heilbronn?", "acceptedAnswer": {"@type": "Answer", "text": "Nein, nach aktuellem Stand betreibt Starbucks in Heilbronn nur den einen Standort an der Kilianstraße 6."}},
        {"@type": "Question", "name": "Bietet die Filiale in Heilbronn kostenloses WLAN?", "acceptedAnswer": {"@type": "Answer", "text": "Ja, der Store Locator listet für die Kilianstraße 6 einen drahtlosen Hotspot."}},
        {"@type": "Question", "name": "Kann ich bei Starbucks in Heilbronn vorbestellen?", "acceptedAnswer": {"@type": "Answer", "text": "Ja, Mobile Order & Pay ist für diesen Standort gelistet; die Bestellung wird im Store abgeholt."}},
        {"@type": "Question", "name": "Kann ich Starbucks-Rewards-Sterne in Heilbronn einlösen?", "acceptedAnswer": {"@type": "Answer", "text": "Ja, die Einlösung von Starbucks Rewards ist für die Kilianstraße 6 gelistet."}},
        {"@type": "Question", "name": "Gibt es bei Starbucks in Heilbronn einen Drive-Thru?", "acceptedAnswer": {"@type": "Answer", "text": "Nein, für die Innenstadtfiliale an der Kilianstraße ist kein Drive-Thru-Schalter gelistet."}},
        {"@type": "Question", "name": "Kann ich mir Starbucks in Heilbronn liefern lassen?", "acceptedAnswer": {"@type": "Answer", "text": "Ja, die Filiale ist bei Uber Eats, Wolt und Lieferando gelistet; alternativ lässt sich in denselben Apps die Pick-up-Funktion zur Selbstabholung wählen."}}
