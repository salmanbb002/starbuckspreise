    {
      "@type": "HowTo",
      "@id": "https://starbuckspreise.com/blog/starbucks-wlan/#howto",
      "name": "Wie melde ich mich im Starbucks WLAN an?",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "text": "Öffne die WLAN-Einstellungen an Smartphone, Tablet oder Laptop."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "text": "Wähle das Netz der Filiale. Frag im Zweifel an der Theke nach dem Namen."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "text": "Warte, bis sich die Anmeldeseite öffnet. Öffne sonst den Browser und rufe eine beliebige Seite auf."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "text": "Bestätige die Nutzungsbedingungen und tippe auf Verbinden."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "text": "Prüfe mit einer Webseite, ob die Verbindung steht."
        }
      ]
    }
