  "FAQPage.mainEntity (append)": [
    {
      "@type": "Question",
      "name": "Is there an English Starbucks menu in Germany?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The drink names on German Starbucks menus are the same English names used worldwide, such as Caffè Latte and Frappuccino®. Food names and the words for milk and toppings are often German. Starbucks also publishes an official English version of the German menu at starbucks.de/en/menu."
      }
    },
    {
      "@type": "Question",
      "name": "Was bedeutet „Starbucks Drinks“ auf der deutschen Karte?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "„Drinks“ ist der englische Oberbegriff für alle Getränke auf der Karte, von Espresso und Latte über Frappuccino® und Refresha® bis zu Tee und heißer Schokolade. Auf der englischen Menüseite von starbucks.de heißen die Rubriken „Hot Drinks“, „Iced Drinks“, „Frappuccino® Blended Beverages“ und „Matcha“."
      }
    },
    {
      "@type": "Question",
      "name": "Wer stellt Starbucks Produkte im Supermarkt her?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nestlé. Seit der Global Coffee Alliance von 2018 hält Nestlé die weltweite Lizenz für verpackte Starbucks-Produkte wie Kapseln, Bohnen und gemahlenen Kaffee. Die Coffee Houses in Deutschland betreibt dagegen AmRest."
      }
    },
    {
      "@type": "Question",
      "name": "Schmecken Starbucks Kapseln wie das Getränk in der Filiale?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nicht ganz. Kapseln werden industriell für Nespresso- oder Dolce-Gusto-Maschinen hergestellt, das Getränk in der Filiale macht ein Barista mit Espresso und frisch aufgeschäumter Milch. Rezept, Milch und Nährwerte unterscheiden sich deshalb."
      }
    }
  ]
}