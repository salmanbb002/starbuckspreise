    {
      "@type": "HowTo",
      "@id": "https://starbuckspreise.com/blog/starbucks-gutschein/#howto",
      "name": "Wie prüfe ich das Guthaben meiner Starbucks Card?",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "text": "Öffne die Starbucks App oder melde dich auf starbucks.de an."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "text": "Lege ein Konto bei Starbucks Rewards an, falls du noch keines hast."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "text": "Gib die 16-stellige Kartennummer und die 8-stellige PIN von der Rückseite der Karte ein."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "text": "Lies das Guthaben in der Kartenübersicht ab."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "text": "Lade bei Bedarf direkt in der App nach."
        }
      ]
    }
