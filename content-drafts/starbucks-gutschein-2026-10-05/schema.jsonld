    {
      "@type": "FAQPage",
      "@id": "https://starbuckspreise.com/blog/starbucks-gutschein#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Kann ich einen Starbucks Gutschein online kaufen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bei Starbucks selbst nicht. Die Plastikkarte gibt es laut FAQ nur im Store, die digitale Karte nur in der App. Online-Händler für Geschenkkarten verkaufen eigene Codes per E-Mail."
          }
        },
        {
          "@type": "Question",
          "name": "Kann ich einen Starbucks Gutschein bei REWE, dm oder an der Tankstelle kaufen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Starbucks nennt keine Supermärkte, Drogerien oder Tankstellen als Verkaufsstellen. In der FAQ heißt es, die Card gebe es nur im Store. Ältere Angaben zu Postbank oder Supermärkten sind überholt."
          }
        },
        {
          "@type": "Question",
          "name": "Was ist der Mindestbetrag für einen Starbucks Gutschein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Der kleinste Betrag ist 5 €. Das gilt für die erste Aufladung und für jede weitere. Pro Monat sind höchstens 250 € möglich."
          }
        },
        {
          "@type": "Question",
          "name": "Kann ich mir das Guthaben auszahlen lassen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein. Laut AGB ist eine Auszahlung aus gesetzlichen Gründen nicht möglich, solange das Programm besteht. Das gilt auch, wenn du dein Konto löschst."
          }
        },
        {
          "@type": "Question",
          "name": "Verfällt das Guthaben auf der Starbucks Card?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein festes Ablaufdatum gibt es nicht. Es gelten die gesetzlichen Verjährungsfristen, in der Regel drei Jahre zum Jahresende. Gebühren für ungenutztes Guthaben verlangt Starbucks nicht."
          }
        },
        {
          "@type": "Question",
          "name": "Kann ich den Gutschein am Flughafen oder Bahnhof einlösen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oft nicht. Viele Standorte an Flughäfen, Bahnhöfen und Raststätten sind Lizenzstores und nehmen die Starbucks Card nicht an. Die Liste steht in Abschnitt 4."
          }
        },
        {
          "@type": "Question",
          "name": "Kann ich mit dem Gutschein in der App vorbestellen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, wenn die Karte in deinem Konto registriert ist. Dann zahlst du Vorbestellungen mit dem Guthaben der Karte. Die Sterne werden automatisch gutgeschrieben."
          }
        },
        {
          "@type": "Question",
          "name": "Kann ich mehrere Starbucks Cards zusammenlegen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In deinem Konto kannst du mehrere Karten registrieren. Alle registrierten Karten sammeln Sterne im selben Rewards-Konto. Ob sich Guthaben zwischen Karten verschieben lässt, nennt die aktuelle FAQ nicht, frag dazu den Gästeservice."
          }
        },
        {
          "@type": "Question",
          "name": "Was mache ich, wenn meine Starbucks Card nicht funktioniert?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bei einem Defekt ist das Guthaben einer registrierten Karte laut AGB geschützt. Schreibe an Starbucks.Gaesteservice@amrest.eu und nenne deine E-Mail-Adresse und die Kartennummer. Prüfe vorher, ob die Filiale ein Lizenzstore ist."
          }
        },
        {
          "@type": "Question",
          "name": "Sammle ich mit dem Gutschein Sterne?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, sobald die Karte registriert ist. Du bekommst 3 Sterne pro ausgegebenem Euro. Ohne Registrierung zahlst du nur, sammelst aber nichts."
          }
        },
        {
          "@type": "Question",
          "name": "Gilt ein Starbucks Gutschein aus den USA in Deutschland?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein. Das deutsche Kartensystem läuft über AmRest und ist von anderen Ländern getrennt. Eine US-Karte lässt sich in Deutschland nicht einlösen."
          }
        },
        {
          "@type": "Question",
          "name": "Kann ich einen WUNSCHGUTSCHEIN direkt im Starbucks einlösen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein, nicht direkt an der Kasse. Du tauschst den Code zuerst online gegen einen Starbucks Gutschein. Der WUNSCHGUTSCHEIN ist 3 Jahre gültig und in Werten von 15 € bis 200 € erhältlich."
          }
        }
      ]
