    {
      "@type": "FAQPage",
      "@id": "https://starbuckspreise.com/blog/starbucks-fuer-kinder/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Gibt es bei Starbucks Getränke für Kinder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, aber keine eigene Kinderkarte. Für Kinder passen Cream Frappuccinos, Classic Hot Chocolate, Hot Milk, Apfelschorle und Wasser. Sie enthalten keinen Espresso."
          }
        },
        {
          "@type": "Question",
          "name": "Welches Starbucks Getränk ist für Kinder geeignet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Am einfachsten sind der Strawberries and Cream Frappuccino, die Classic Hot Chocolate und Wasser. Sie enthalten keinen Kaffee. Eine ärztliche Empfehlung zu Koffein geben wir nicht, frag den Kinderarzt."
          }
        },
        {
          "@type": "Question",
          "name": "Was kostet ein Kindergetränk bei Starbucks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Von 0,15 € für Sprudelwasser bis 5,35 € für einen Vanilla Cream Frappuccino. Die Classic Hot Chocolate kostet 4,99 €, die Apfelschorle 1,60 €. Die Preise können je nach Filiale abweichen."
          }
        },
        {
          "@type": "Question",
          "name": "Was ist ein Babyccino bei Starbucks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein Babyccino ist aufgeschäumte Milch mit Kakao oder Zimt, ohne Kaffee. In den USA ist er eine Sonderbestellung, keine Karte. Ob deutsche Filialen ihn machen, haben wir nicht geprüft."
          }
        },
        {
          "@type": "Question",
          "name": "Haben Starbucks Frappuccinos Koffein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Coffee Frappuccinos haben Koffein, aber wenig: Ein Grande hat 31,4 mg. Cream Frappuccinos kommen ohne Kaffee aus. Chai Tea Cream und Matcha Tea Cream enthalten Tee und damit Koffein."
          }
        },
        {
          "@type": "Question",
          "name": "Hat die heiße Schokolade bei Starbucks Koffein?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Das Koffein liegt nahe null, weil kein Espresso enthalten ist. Eine exakte Zahl nennt Starbucks nicht. Kakao enthält von Natur aus Spuren von Koffein."
          }
        },
        {
          "@type": "Question",
          "name": "Was ist das Kinder Bueno Getränk von Starbucks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein Fan-Rezept aus Großbritannien und den USA mit White-Mocha-Sauce, Haselnuss-Sirup und Schoko-Cold-Foam. Es steht nicht auf der deutschen Karte. Das Original enthält Espresso."
          }
        },
        {
          "@type": "Question",
          "name": "Hat Starbucks einen Kinderbecher?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein eigenes Kindergetränk-Becherangebot haben wir nicht gefunden. Starbucks verkauft Tassen und Becher als Sammlerstücke, siehe Starbucks Becher. Ob ein Kinderbecher im Sortiment ist, haben wir nicht geprüft."
          }
        },
        {
          "@type": "Question",
          "name": "Gibt es bei Starbucks Kindergetränke ohne Zucker?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wasser enthält keinen Zucker, Hot Milk nur den natürlichen Milchzucker. Frappuccinos, Schokolade und Schorle haben deutlich mehr Zucker, erkennbar an 115 bis 322 kcal. Zuckerfreie Sirups gibt es nur für einzelne Sorten wie Vanille."
          }
        },
        {
          "@type": "Question",
          "name": "Welche Starbucks Getränke sind koffeinfrei?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wasser, Hot Milk, Apfelschorle und Cream Frappuccinos wie Strawberries and Cream oder Vanilla Cream. Refresha, Chai und Matcha sind nicht koffeinfrei."
          }
        },
        {
          "@type": "Question",
          "name": "Darf mein Kind bei Starbucks einen Latte trinken?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Das entscheidest du mit dem Kinderarzt. Ein Caffè Latte in Tall oder Grande enthält zwei Espresso-Shots mit 89,1 mg Koffein. Eine Alternative ist ein Latte ohne Espresso, also warme Milch."
          }
        },
        {
          "@type": "Question",
          "name": "Kann ich bei Starbucks mit Kindern Milch bestellen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, als Hot Milk. Laut Preisliste kostet sie 8,50 € und hat 203 kcal, der Preis wirkt hoch und sollte vor Ort geprüft werden. Alternativ bestellst du einen Pflanzendrink, falls dein Kind Kuhmilch nicht verträgt."
          }
        }
      ]
    }
  ]
