    {
      "@type": "HowTo",
      "@id": "https://starbuckspreise.com/blog/starbucks-cerca-de-mi#howto",
      "name": "Encontrar una sucursal cercana",
      "inLanguage": "es",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "text": "Abre el mapa o el localizador y revisa el lugar desde el que estás buscando."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "text": "Permite el acceso a tu ubicación si quieres usarla, o introduce manualmente tu ciudad y dirección de referencia."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "text": "Busca Starbucks y selecciona una sucursal concreta, no solo el nombre general de la cadena."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "text": "Comprueba la calle, el horario correspondiente a tu visita y el enlace a la ficha oficial."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "text": "Calcula el trayecto con tu medio de transporte y decide si llegarás con tiempo para pedir."
        }
      ]
    }
