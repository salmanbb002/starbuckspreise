    {
      "@type": "HowTo",
      "@id": "https://starbuckspreise.com/blog/starbucks-americano/#howto",
      "name": "Wie mache ich einen Americano wie bei Starbucks zu Hause?",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "text": "Wärme eine große Tasse mit heißem Wasser vor und gieße es wieder aus."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "text": "Brühe einen doppelten Espresso, also 45 bis 60 ml, direkt in die Tasse."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "text": "Erhitze frisches Wasser im Wasserkocher."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "text": "Gieße 120 bis 180 ml heißes Wasser auf den Espresso."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "text": "Probiere und gib bei Bedarf mehr Wasser dazu."
        }
      ]
    }
  ]
