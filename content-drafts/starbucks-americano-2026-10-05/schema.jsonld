    {
      "@type": "FAQPage",
      "@id": "https://starbuckspreise.com/blog/starbucks-americano#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Ist ein Americano einfach nur verdünnter Espresso?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, im Kern schon. Ein Americano ist Espresso, der mit heißem Wasser gestreckt wird. Dadurch wird er so groß wie ein Filterkaffee, behält aber den Röstgeschmack des Espressos."
          }
        },
        {
          "@type": "Question",
          "name": "Hat ein Americano mehr Koffein als ein Latte?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. Ein Grande Americano hat 133,6 mg Koffein, ein Grande Caffè Latte 89,1 mg. Im Grande enthält der Americano drei Shots, der Latte zwei."
          }
        },
        {
          "@type": "Question",
          "name": "Ist der Starbucks Americano vegan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, ein schwarzer Americano besteht nur aus Espresso und Wasser. Er enthält keine Milch und keinen Sirup. Achte bei Extras auf pflanzliche Milch."
          }
        },
        {
          "@type": "Question",
          "name": "Hat ein Americano Zucker?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Praktisch nicht. Ein Grande Americano enthält laut Starbucks Deutschland 0,1 g Zucker. Süß wird er erst mit Sirup oder Zucker, den du selbst dazugibst."
          }
        },
        {
          "@type": "Question",
          "name": "Kann ich den Americano entkoffeiniert bestellen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. Der Decaf Americano steht in der Nährwerttabelle von Starbucks Deutschland. Ein Grande hat 5,4 mg Koffein statt 133,6 mg."
          }
        },
        {
          "@type": "Question",
          "name": "Was ist ein Blonde Americano?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein Blonde Americano wird mit der helleren Blonde-Espresso-Röstung zubereitet. Er schmeckt milder als der klassische Americano. Im Grande hat er 128,2 mg Koffein und 9 kcal."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viel Koffein hat ein Venti Iced Americano?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein Venti Iced Americano hat 178,2 mg Koffein. Das ist derselbe Wert wie beim heißen Venti Americano. Beide enthalten rechnerisch vier Espresso-Shots."
          }
        },
        {
          "@type": "Question",
          "name": "Gibt es den Americano in Short?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, den heißen Americano führt die Nährwerttabelle auch in Short mit 237 ml. Er enthält einen Shot mit 44,5 mg Koffein und 4 kcal. Den Iced Americano gibt es erst ab Tall."
          }
        },
        {
          "@type": "Question",
          "name": "Ist ein Americano gesünder als ein Cappuccino?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Er hat deutlich weniger Kalorien. Ein Grande Americano hat 11 kcal, ein Grande Cappuccino mit Halbfettmilch 130 kcal. Dafür liefert der Cappuccino 9,4 g Eiweiß aus der Milch."
          }
        },
        {
          "@type": "Question",
          "name": "Bekomme ich für einen Americano Sterne bei Starbucks Rewards?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. Für jeden ausgegebenen Euro bekommst du 3 Sterne, wenn du dein Rewards-Konto an der Kasse scannst. Ein Americano für 3,50 € bringt also gut 10 Sterne."
          }
        },
        {
          "@type": "Question",
          "name": "Was ist der Unterschied zwischen Americano und Café Crème?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein Americano ist Espresso mit Wasser. Ein Café Crème wird wie ein langer Espresso direkt in die große Tasse gebrüht, das Wasser läuft also durch das Kaffeemehl. Er hat deshalb mehr Crema."
          }
        }
      ]
    },
