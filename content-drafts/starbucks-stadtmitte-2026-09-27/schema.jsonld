    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wo ist der Starbucks am U-Bahnhof Stadtmitte in Berlin?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Er liegt an der Friedrichstraße 61, 10117 Berlin, wenige Gehminuten vom U-Bahnhof Stadtmitte (U2, U6). Laut Store-Locator hat er Mo–Sa 7:30–20:00 und So 9:00–19:00 Uhr geöffnet."
          }
        },
        {
          "@type": "Question",
          "name": "Welcher Starbucks in Düsseldorf hat am längsten geöffnet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die Filiale im Hauptbahnhof am Konrad-Adenauer-Platz 14 öffnet werktags um 6:00 Uhr und schließt täglich um 22:00 Uhr. Die Filiale an der Schadowstraße schließt schon um 20:00 Uhr, sonntags um 18:00 Uhr."
          }
        },
        {
          "@type": "Question",
          "name": "Gibt es noch einen Starbucks an der Königsallee in Düsseldorf?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, an der Ecke Steinstraße 1-3. Die frühere Filiale an der Königsallee 40 ist dauerhaft geschlossen, wird in einigen Verzeichnissen aber noch geführt."
          }
        },
        {
          "@type": "Question",
          "name": "Gibt es einen Starbucks Reserve in Düsseldorf?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Das Coffee House an der Steinstraße 1-3 an der Kö bietet seit der Eröffnung 2018 Reserve-Kaffees an. Das sind seltene Kaffees aus einzelnen Anbaugebieten, die es zusätzlich zum normalen Sortiment gibt."
          }
        },
        {
          "@type": "Question",
          "name": "Hat der Starbucks in Esslingen noch geöffnet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein. Die Filiale in der Pliensaustraße 8 in Esslingen am Neckar hat im Februar 2020 geschlossen. Einträge mit Öffnungszeiten in Branchenverzeichnissen sind veraltet."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viele Starbucks gibt es in der Stuttgarter Innenstadt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An der Königstraße gibt es zwei Coffee Houses: Königstraße 44 und in den Königsbau Passagen. Dazu kommt ein Starbucks-Kiosk im Stuttgarter Hauptbahnhof."
          }
        },
        {
          "@type": "Question",
          "name": "Welcher Starbucks in Stuttgart hat am Wochenende am längsten auf?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Die Filiale in den Königsbau Passagen hat freitags und samstags bis 23:00 Uhr geöffnet. Sonntags schließen beide Filialen an der Königstraße um 21:00 Uhr."
          }
        },
        {
          "@type": "Question",
          "name": "Hat Starbucks in der Stadtmitte sonntags geöffnet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, für fünf der sechs Filialen sind Sonntagszeiten veröffentlicht, meist mit späterem Start als unter der Woche. Am frühesten öffnet sonntags der Düsseldorfer Hauptbahnhof um 8:00 Uhr; für die Steinstraße 1-3 prüf die Zeiten im Store-Locator."
          }
        },
        {
          "@type": "Question",
          "name": "Gibt es WLAN in den Stadtmitte-Filialen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Für die Filialen Friedrichstraße 61, Schadowstraße 11, Königstraße 44 und Königsbau Passagen nennen Store-Locator und Gästebewertungen kostenloses WLAN. Für die übrigen Filialen haben wir keine Angabe gefunden, frag im Zweifel vor Ort nach."
          }
        },
        {
          "@type": "Question",
          "name": "Kann ich in einer Stadtmitte-Filiale per App vorbestellen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Für die Berliner Filiale an der Friedrichstraße 61 nennt der Store-Locator Mobile Order. Ob eine Filiale die Vorbestellung anbietet, siehst du in der Starbucks App, sobald du sie auswählst."
          }
        },
        {
          "@type": "Question",
          "name": "Ist der Starbucks an der Friedrichstraße 96 derselbe wie an der Stadtmitte?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein. Die Friedrichstraße 96 liegt am Bahnhof Friedrichstraße, rund einen Kilometer nördlich. Der Starbucks am U-Bahnhof Stadtmitte ist die Friedrichstraße 61."
          }
        }
      ]
    },
