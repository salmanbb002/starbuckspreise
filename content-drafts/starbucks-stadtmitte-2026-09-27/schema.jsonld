    {
      "@type": "HowTo",
      "name": "So prüfst du, ob eine Starbucks-Filiale in der Stadtmitte heute geöffnet hat",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "text": "Öffne starbucks.de und wähle „Coffee House finden“ oder öffne die Starbucks App."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "text": "Gib die Straße ein, zum Beispiel „Friedrichstraße Berlin“ oder „Königstraße Stuttgart“, nicht nur „Stadtmitte“."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "text": "Tipp die Filiale an und prüf die Tageszeiten, besonders sonntags und an Feiertagen."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "text": "Gleich den Standort in Google Maps mit den „Beliebten Zeiten“ ab, wenn du Wartezeiten vermeiden willst."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "text": "Ist eine Filiale nicht im Store-Locator zu finden, geh davon aus, dass sie geschlossen ist."
        }
      ]
