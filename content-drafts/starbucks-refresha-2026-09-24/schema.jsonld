    {
      "@type": "FAQPage",
      "@id": "https://starbuckspreise.com/blog/starbucks-refresha/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Was ist ein Starbucks Refresha?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ein Refresha ist ein kaltes Fruchtgetränk von Starbucks aus Fruchtsaftkonzentrat, Fruchtstücken, Eis und Extrakt aus grünen Kaffeebohnen. Er schmeckt fruchtig, nicht nach Kaffee, enthält aber etwas Koffein."
          }
        },
        {
          "@type": "Question",
          "name": "Welche Refresha-Sorten gibt es in Deutschland?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aktuell gibt es Mango Dragonfruit, Strawberry Acai, Dragon Coconut und Pink Coconut, dazu Frozen Mango Dragonfruit und Frozen Strawberry Acai. Das sind sechs Sorten laut starbucks.de."
          }
        },
        {
          "@type": "Question",
          "name": "Was kostet ein Refresha bei Starbucks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Laut unserer Preisliste zwischen 6,40 € (Strawberry Acai) und 7,90 € (Pink Coconut). Die Coconut-Varianten kosten wegen des Kokosdrinks 0,50 € (Dragon Coconut) bzw. 1,50 € (Pink Coconut) mehr als ihre Grundsorte."
          }
        },
        {
          "@type": "Question",
          "name": "Wie viel Koffein hat ein Refresha?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Starbucks Deutschland nennt keinen Wert. In den USA gibt Starbucks für einen Grande rund 45 bis 50 mg an, etwa ein Drittel eines Grande Caffè Latte."
          }
        },
        {
          "@type": "Question",
          "name": "Ist Refresha koffeinfrei?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein. Das Koffein stammt aus Grünkaffee-Extrakt und ist in jeder Sorte enthalten, auch wenn man es nicht schmeckt."
          }
        },
        {
          "@type": "Question",
          "name": "Welcher Refresha hat die wenigsten Kalorien?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Strawberry Acai mit 87 kcal laut unserer Liste, gefolgt von Mango Dragonfruit mit 101 kcal. Die Coconut-Sorten liegen bei 144 bis 158 kcal."
          }
        },
        {
          "@type": "Question",
          "name": "Was ist der Unterschied zwischen Refresha und Refresher?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Keiner beim Konzept. „Refresha“ ist der Name in Deutschland, „Refreshers“ der Name in den USA und vielen anderen Ländern. Die Sortenauswahl und die Rezepturen können sich je nach Land unterscheiden."
          }
        },
        {
          "@type": "Question",
          "name": "Ist der Pink Drink bei Starbucks Deutschland erhältlich?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, unter dem Namen Pink Coconut Refresha®. Er kombiniert die Erdbeer-Acai-Basis mit cremigem Kokosdrink und kostet laut unserer Liste 7,90 €."
          }
        },
        {
          "@type": "Question",
          "name": "Seit wann gibt es Refresha in Deutschland?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Seit dem 10. Juli 2012. Zum Start gab es die Sorten Cool Lime und Very Berry Hibiscus, die heute nicht mehr auf der Karte stehen."
          }
        },
        {
          "@type": "Question",
          "name": "Gibt es Cool Lime noch bei Starbucks?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nein, Cool Lime steht nicht mehr im deutschen Refresha-Sortiment auf starbucks.de. Aktuell basiert die Linie auf Mango-Dragonfruit und Strawberry-Acai."
          }
        },
        {
          "@type": "Question",
          "name": "Was ist ein Frozen Refresha?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Eine gemixte Variante, bei der die Refresha-Basis mit gefriergetrockneten Früchten, Frozen-Refresha-Pulver und Eis zu einer Art Slush verarbeitet wird. Es gibt sie als Mango Dragonfruit und Strawberry Acai."
          }
        },
        {
          "@type": "Question",
          "name": "Kann ich Refresha in der Starbucks App bestellen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In teilnehmenden Filialen kannst du über die Starbucks-Deutschland-App vorbestellen, Refresha steht dort bei den Kaltgetränken. Beim Bezahlen per App oder Starbucks Card sammelst du wie bei jedem Getränk 3 Stars pro Euro."
          }
        }
      ]
    }
  ]
