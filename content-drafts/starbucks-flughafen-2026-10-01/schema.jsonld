    {
      "@type": "HowTo",
      "name": "Starbucks auf Reisen finden",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "text": "Store Locator auf starbucks.de oder in der App öffnen und Flughafen oder Bahnhof eingeben."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "text": "Öffnungszeiten für den Reisetag prüfen; Sonn- und Feiertage weichen oft ab."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "text": "Am Flughafen auf den Bereich achten: öffentlich oder hinter der Sicherheitskontrolle."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "text": "Bei den Merkmalen nach „Redeem Rewards“ schauen, wenn Sterne eingelöst werden sollen."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "text": "Bei Lizenzstores eine andere Zahlungsart einplanen, da die Starbucks Card dort nicht funktioniert."
        }
      ]
    }
