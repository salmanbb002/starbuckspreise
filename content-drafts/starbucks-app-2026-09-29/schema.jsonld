          "name": "Filiale wählen",
          "text": "Wähle einen Store in der Nähe, der Vorbestellung anbietet."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Getränk auswählen und anpassen",
          "text": "Stelle Größe, Milchsorte, Sirup und Extras ein."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Bezahlen",
          "text": "Bezahle mit dem Guthaben deiner digitalen Starbucks Card; die Sterne werden automatisch gutgeschrieben."
        },
