{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.starbuckspreise.com"
        }
      ],
      "destination": "https://starbuckspreise.com/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.starbuckspreise.com"
        }
      ],
      "destination": "https://starbuckspreise.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    },
    {
      "source": "/(styles.css|menu.js|favicon.svg|logo.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/starbucks-tassen",
      "destination": "/blog/starbucks-tassen"
    },
    {
      "source": "/starbucks-getraenke",
      "destination": "/blog/starbucks-getraenke"
    },
    {
      "source": "/starbucks-a-proximite",
      "destination": "/blog/starbucks-a-proximite"
    },
    {
      "source": "/starbucks-geoeffnet",
      "destination": "/blog/starbucks-geoeffnet"
    },
    {
      "source": "/starbucks-closest-to-me",
      "destination": "/blog/starbucks-closest-to-me.html"
    },
    {
      "source": "/blog/starbucks-closest-to-me",
      "destination": "/blog/starbucks-closest-to-me.html"
    },
    {
      "source": "/starbucks-near-me",
      "destination": "/blog/starbucks-near-me.html"
    },
    {
      "source": "/blog/starbucks-near-me",
      "destination": "/blog/starbucks-near-me.html"
    }
  ]
}